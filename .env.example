# FactorioAccess — local machine configuration.
#
# Copy this file to `.env` (gitignored) and fill in the paths for your machine.
# The justfile picks these up via `set dotenv-load`.
#
# **Wrap every value in single quotes.**  The dotenv parser interprets
# backslashes inside unquoted or double-quoted values, which mangles Windows
# paths; single quotes are taken literally.

# The Steam Factorio install: the folder holding bin\x64\factorio.exe and
# factorio.pdb.  `just deploy` puts winmm.dll into its bin\x64.
FACTORIO_STEAM_DIR='C:\Program Files (x86)\Steam\steamapps\common\Factorio'

# The Steam game's write-data folder (installer builds use the system one).
# `just link-mod` links this checkout into its mods\, `just game-log` reads
# its factorio-current.log.
FACTORIO_USER_DIR='C:\Users\<you>\AppData\Roaming\Factorio'

# A self-contained (zip) Factorio install used for headless tests, with
# mods\FactorioAccess a junction to this checkout.  `just test-mod` runs there
# when set (otherwise in the install around this checkout); `just symbols`
# also checks it.
FACTORIO_SANDBOX_DIR=''

# Path to vcvars64.bat.  The build uses Ninja, which calls cl directly, so
# `just configure`, `just build` and `just clangd` run inside it.
VCVARS64='C:\Program Files (x86)\Microsoft Visual Studio\18\BuildTools\VC\Auxiliary\Build\vcvars64.bat'

# Steam app id; Factorio is 427520.
# FACTORIO_STEAM_APPID='427520'
